# syntax=docker/dockerfile:1-labs
#
# Build context: repo root (EAP-New-Form/)
# so both go-api/ and implementation_inputs/ are accessible.
#
# Build command:
#   gcloud builds submit --config go-api/trigger_builder_standalone/cloudbuild.yaml \
#     --substitutions=_IMAGE_TAG=<source-bundle-id> .

FROM python:3.11.13-slim-bookworm@sha256:86adf8dbadc3d6e82ee5dd2c74bec2e1c2467cdad47886280501df722372d2e1 AS base

# Install uv — same version as go-api Dockerfile
COPY --from=ghcr.io/astral-sh/uv:0.6.2@sha256:01ddc2a91588f1210396433c79c9f58848ad668ea05bda895f5a1a31f2e5b64f /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV UV_PROJECT_ENVIRONMENT="/usr/local/"
ENV UV_CACHE_DIR="/root/.cache/uv"

WORKDIR /app

# ── Install Python dependencies ───────────────────────────────────────────────
COPY go-api/trigger_builder_standalone/pyproject.toml ./pyproject.toml
COPY go-api/trigger_builder_standalone/uv.lock ./uv.lock

RUN --mount=type=cache,target=$UV_CACHE_DIR \
    uv sync --frozen --no-dev --no-install-project

# ── Copy application code ─────────────────────────────────────────────────────
COPY go-api/trigger_builder/ ./trigger_builder/
COPY go-api/trigger_builder_standalone/ ./trigger_builder_standalone/

# ── Copy data files needed by the schema and examples endpoints ───────────────
COPY implementation_inputs/examples/pilot_eaps.json ./implementation_inputs/examples/pilot_eaps.json
# Pilot statements are generated by the frontend sync script — copy the generated file.
COPY go-web-app/packages/trigger-builder-prototype/src/data/generated/pilot_eap_statements.json \
     ./implementation_inputs/examples/pilot_eap_statements.json
# The compact schema is pre-processed by the frontend sync script.
# We copy the generated compact JSON (NaN already sanitized) rather than the raw source.
COPY go-web-app/packages/trigger-builder-prototype/src/data/generated/ui_schema_compact.json \
     ./implementation_inputs/schema/ui_schema_compact.json

# ── Runtime environment ───────────────────────────────────────────────────────
ENV DJANGO_SETTINGS_MODULE=trigger_builder_standalone.settings
ENV IMPLEMENTATION_INPUTS_DIR=/app/implementation_inputs
ENV GCP_PROJECT_ID=eap-form-prototype
ENV GCP_LOCATION=global
ENV GEMINI_MODEL_ID=gemini-3.5-flash
ENV GEMINI_PROMPT_VERSION=phase1-v1
ENV GEMINI_REQUEST_TIMEOUT_SECONDS=150

EXPOSE 8080

# gunicorn — Cloud Run handles HTTPS termination, so plain HTTP on 8080 is correct.
CMD ["gunicorn", \
     "--bind", "0.0.0.0:8080", \
     "--workers", "2", \
     "--threads", "4", \
     "--timeout", "170", \
     "trigger_builder_standalone.wsgi:application"]
